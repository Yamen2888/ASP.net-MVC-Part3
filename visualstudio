@model IEnumerable<YourProjectName.Models.Insuree>

@{
    ViewBag.Title = "Admin Dashboard";
}

<h2>Admin Dashboard - All Quotes</h2>

<table class="table">
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email Address</th>
        <th>Calculated Quote</th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
        <td>@Html.DisplayFor(modelItem => item.LastName)</td>
        <td>@Html.DisplayFor(modelItem => item.EmailAddress)</td>
        <td>@String.Format("{0:C}", item.Quote)</td>
    </tr>
}
</table>public ActionResult Admin()
{
    // Fetches all records from the database to present to the admin view
    return View(db.Insurees.ToList());
